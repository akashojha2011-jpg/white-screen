---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Terms & Conditions – White Screen" description="Read the Terms and Conditions for TheWhiteScreen.org. Guidelines for using our online white screen and background generator tool.">
