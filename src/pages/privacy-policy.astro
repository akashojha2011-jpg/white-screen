---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Privacy Policy – White Screen" description="Read the Privacy Policy for TheWhiteScreen.org. Learn how we protect your privacy with zero personal data tracking.">
  <div class="container" style="max-width: 900px; margin: 40px auto; padding: 0 20px;">
    <article class="seo-content-article">
      <h1>Privacy Policy</h1>
      <p><em>Last Updated: August 28, 2026</em></p>

      <p>
        At <strong>TheWhiteScreen.org</strong>, we take your privacy very seriously. This Privacy Policy outlines our commitment to protecting your personal information while using our website and tools.
      </p>

      <h2>1. Information We Collect</h2>
      <p>
        <strong>TheWhiteScreen.org does NOT collect, capture, or store any personal data.</strong>
      </p>
      <ul>
        <li>No user accounts or sign-ups are required to use our tools.</li>
        <li>We do not track your IP address, browsing behavior, or device identifiers.</li>
        <li>All canvas image rendering and color calculations occur 100% locally inside your web browser. No uploaded or generated images are ever transmitted to our servers.</li>
      </ul>

      <h2>2. Local Storage Usage</h2>
      <p>
        We use browser <code>localStorage</code> solely to save your local UI preferences (such as Dark Mode toggle preference and custom saved favorite screen colors). This data remains strictly stored on your own device and is never shared with third parties.
      </p>

      <h2>3. Third-Party Services & Analytics</h2>
      <p>
        We use minimal, privacy-focused analytics to monitor page performance and uptime. No personally identifiable information (PII) is gathered or sold to advertisers.
      </p>

      <h2>4. Changes to This Policy</h2>
      <p>
        We may update our Privacy Policy periodically to reflect technological improvements. Any updates will be posted directly on this page.
      </p>

      <h2>5. Contact Us</h2>
      <p>
        If you have any questions regarding this Privacy Policy, please contact us at <strong>privacy@thewhitescreen.org</strong> or visit our <a href="/contact">Contact Page</a>.
      </p>
    </article>
  </div>
</Layout>
