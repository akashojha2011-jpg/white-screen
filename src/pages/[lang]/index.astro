---
import Layout from '../../layouts/Layout.astro';
import ScreenTool from '../../components/ScreenTool.astro';
import DownloadCanvas from '../../components/DownloadCanvas.astro';
import FAQSection from '../../components/FAQSection.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { NON_DEFAULT_LANGUAGES, type LanguageCode } from '../../i18n/config';
import { getUI } from '../../i18n/ui';
import { getColorById } from '../../content/colors';

export async function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: LanguageCode };
const ui = getUI(lang);
const whiteData = getColorById('white-screen');
const whiteContent = whiteData?.content[lang];

const localizedHomeMeta: Record<LanguageCode, { title: string; desc: string; h1: string }> = {
  en: {
    title: "White Screen 100% Pure Bright White Display Tool (2026)",
    desc: "Instant fullscreen pure white screen tool. Perfect for monitor cleaning, dead pixel tests, Zoom webcam fill lighting, and lightbox tracing. 100% free.",
    h1: "Pure Fullscreen White Screen Tool",
  },
  es: {
    title: "Pantalla Blanca Online – Herramienta de Monitor y Luz (2026)",
    desc: "Herramienta online de pantalla blanca a pantalla completa. Ideal para limpiar monitores, probar píxeles muertos, iluminar videollamadas y calcar dibujos.",
    h1: "Pantalla Blanca en Pantalla Completa",
  },
  fr: {
    title: "Écran Blanc en Ligne – Outil d'Écran et Éclairage Pur (2026)",
    desc: "Outil en ligne d'écran blanc pur en plein écran. Idéal pour le nettoyage d'écran, la détection de pixels morts, l'éclairage de visio et le décalquage.",
    h1: "Outil Écran Blanc Plein Écran",
  },
  de: {
    title: "Weißer Bildschirm Online – Reines Display-Tool (2026)",
    desc: "Kostenloses Vollbild-Werkzeug für weiße Bildschirme. Perfekt zur Monitor-Reinigung, Pixelfehlertests, Videokonferenz-Beleuchtung und zum Abpausen.",
    h1: "Weißer Vollbild-Bildschirm",
  },
  pt: {
    title: "Tela Branca Online – Ferramenta de Luz e Teste (2026)",
    desc: "Ferramenta de tela branca pura em tela cheia. Perfeita para limpeza de monitores, teste de pixels mortos, iluminação de webcam e decalques.",
    h1: "Ferramenta de Tela Branca em Tela Cheia",
  },
  id: {
    title: "Layar Putih Online – Alat Monitor dan Lampu Video (2026)",
    desc: "Utilitas layar putih penuh online instan. Sangat cocok untuk membersihkan monitor, tes piksel mati, pencahayaan webcam Zoom, dan meja gambar jiplak.",
    h1: "Alat Layar Putih Penuh Online",
  },
  it: {
    title: "Schermo Bianco Online – Strumento Display e Luce Pura (2026)",
    desc: "Strumento online per schermo bianco a schermo intero. Ideale per pulire monitor, testare pixel bruciati, illuminare videochiamate e ricalcare disegni.",
    h1: "Strumento Schermo Bianco a Schermo Intero",
  },
  nl: {
    title: "Wit Scherm Online – Schermtool & Zuivere Verlichting (2026)",
    desc: "Online tool voor een zuiver wit scherm in volledig scherm. Ideaal voor monitorreiniging, dode pixel testen, webcamverlichting en overtrekken.",
    h1: "Volledig Scherm Wit Scherm Tool",
  },
  pl: {
    title: "Biały Ekran Online – Narzędzie do Monitora i Światło (2026)",
    desc: "Błyskawiczne narzędzie online do wyświetlania czystego białego ekranu. Idealne do czyszczenia monitora, testu martwych pikseli i doświetlania kamery.",
    h1: "Czysty Biały Ekran Pełnoekranowy",
  },
  tr: {
    title: "Beyaz Ekran Online – Tam Ekran Monitör ve Işık Aracı (2026)",
    desc: "Anında tam ekran saf beyaz ekran aracı. Monitör temizliği, ölü piksel testi, Zoom kamera aydınlatması ve çizim masası için %100 ücretsiz.",
    h1: "Saf Tam Ekran Beyaz Ekran Aracı",
  },
  ja: {
    title: "白い画面 オンライン – 全画面ホワイトスクリーンツール (2026)",
    desc: "即座に全画面で純白の画面を表示する無料ツール。モニター掃除、ドット抜けテスト、ZoomやWebカメラの照明、トレース台に最適。",
    h1: "全画面 白い画面ツール",
  },
  ko: {
    title: "하얀 화면 온라인 – 전체화면 화이트 스크린 도구 (2026)",
    desc: "즉시 전체화면으로 깨끗한 흰색 화면을 띄우는 무료 도구입니다. 모니터 먼지 청소, 불량화소 테스트, 화상회의 조명 및 트레이싱에 적합합니다.",
    h1: "순수한 전체화면 하얀 화면 도구",
  },
};

const currentMeta = localizedHomeMeta[lang] || localizedHomeMeta.en;
const pageTitle = currentMeta.title;
const pageDescription = currentMeta.desc;
const h1 = currentMeta.h1;
const intro = whiteContent?.intro || '';

const relatedTools = [
  { id: 'black-screen', title: 'Black Screen', desc: 'OLED display testing & battery saving' },
  { id: 'blue-screen', title: 'Blue Screen', desc: 'Detect stuck subpixels and enjoy cool ambient light' },
  { id: 'green-screen', title: 'Green Screen', desc: 'Chroma key for video recording and streaming' },
  { id: 'red-screen', title: 'Red Screen', desc: 'Preserve dark-adapted night vision' },
  { id: 'dead-pixel-test', title: 'Dead Pixel Test', desc: 'Inspect panels with primary RGB colors' },
  { id: 'zoom-ring-light', title: 'Zoom Ring Light', desc: 'Soft webcam lighting for video meetings' },
];

const faqs = whiteContent?.faqs || [];
---

<Layout
  pageId="home"
  lang={lang}
  title={pageTitle}
  description={pageDescription}
>
  <!-- Hero Section -->
  <header class="text-center max-w-4xl mx-auto my-6 sm:my-10">
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
      {h1}
    </h1>
    {intro && (
      <p class="mt-4 text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
        {intro}
      </p>
    )}
  </header>

  <!-- Interactive Screen Tool -->
  <ScreenTool
    lang={lang}
    initialColor="#ffffff"
    pageId="home"
  />

  <!-- Wallpaper Download Canvas -->
  <DownloadCanvas
    lang={lang}
    initialColor="#ffffff"
    colorName="White"
  />

  <!-- How to Use Section -->
  <section class="my-16">
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-8 text-center sm:text-left">
      {ui.sections.howToUseTitle}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-base mb-4">
          1
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
          {ui.sections.step1Title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {ui.sections.step1Desc}
        </p>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-base mb-4">
          2
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
          {ui.sections.step2Title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {ui.sections.step2Desc}
        </p>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-base mb-4">
          3
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
          {ui.sections.step3Title}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {ui.sections.step3Desc}
        </p>
      </div>
    </div>
  </section>

  <!-- Real-World Applications -->
  {whiteContent && (
    <section class="my-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-8">
        {whiteContent.useCasesTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {whiteContent.useCases.map((uc) => (
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xs">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">
              {uc.title}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {uc.desc}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Related Tools -->
  <RelatedTools
    lang={lang}
    title={ui.sections.relatedToolsTitle}
    items={relatedTools}
  />

  <!-- FAQs with Schema -->
  {faqs.length > 0 && (
    <FAQSection
      title={ui.sections.faqTitle}
      faqs={faqs}
    />
  )}
</Layout>
