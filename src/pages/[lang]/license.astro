---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
---

<Layout title={`License – ${t('siteTitle')}`} description={t('siteDescription')}>
  <div class="container" style="max-width: 900px; margin: 40px auto; padding: 0 20px;">
    <article class="seo-content-article">
      <h1>License</h1>
      <p>Wallpapers generated on WhiteScreen.dev are free for personal and commercial use without attribution.</p>
    </article>
  </div>
</Layout>
