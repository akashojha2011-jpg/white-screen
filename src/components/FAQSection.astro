---
export interface FAQItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs: FAQItem[];
}

const { title = "Frequently Asked Questions", faqs = [] } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<section class="my-12">
  <div class="max-w-3xl">
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-6">
      {title}
    </h2>

    <div class="space-y-4">
      {faqs.map((f, idx) => (
        <details
          class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs transition-all open:border-indigo-500/50 open:ring-1 open:ring-indigo-500/20"
          open={idx === 0}
        >
          <summary class="flex items-center justify-between font-semibold text-slate-900 dark:text-white cursor-pointer list-none select-none text-base">
            <span>{f.q}</span>
            <span class="ml-4 flex-shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800 pt-3">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
