---
import { PUBLISHED_LANGUAGES, type LanguageCode } from '../i18n/config';
import { getUI } from '../i18n/ui';
import { getRelativePath } from '../i18n/slugs';

export interface Props {
  lang: LanguageCode;
  pageId?: string;
}

const { lang, pageId = 'home' } = Astro.props;
const ui = getUI(lang);

// Home path
const homeHref = lang === 'en' ? '/' : `/${lang}/`;

// Category links localized
const colorsHref = getRelativePath('blue-screen', lang);
const toolsHref = getRelativePath('dead-pixel-test', lang);
const wallpapersHref = getRelativePath('white-wallpaper', lang);
const themesHref = getRelativePath('gradient-background', lang);
const guidesHref = getRelativePath('how-to-clean-laptop-screen-safely', lang);

// Translations for current page across all languages
const languageLinks = Object.entries(PUBLISHED_LANGUAGES).map(([code, info]) => {
  let href: string;
  try {
    href = getRelativePath(pageId, code as LanguageCode);
  } catch {
    href = code === 'en' ? '/' : `/${code}/`;
  }
  return {
    code,
    name: info.name,
    href,
    isActive: code === lang,
  };
});
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={homeHref} class="flex items-center gap-2.5 text-slate-900 dark:text-white font-bold text-lg tracking-tight group focus:outline-hidden focus:ring-2 focus:ring-indigo-500 rounded-lg p-1">
      <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="3" width="18" height="18" rx="3"></rect>
        </svg>
      </div>
      <span>TheWhiteScreen<span class="text-indigo-600 dark:text-indigo-400">.org</span></span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href={colorsHref} class="px-3 py-1.5 rounded-lg hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        {ui.nav.colors}
      </a>
      <a href={toolsHref} class="px-3 py-1.5 rounded-lg hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        {ui.nav.tools}
      </a>
      <a href={wallpapersHref} class="px-3 py-1.5 rounded-lg hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        {ui.nav.wallpapers}
      </a>
      <a href={themesHref} class="px-3 py-1.5 rounded-lg hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        {ui.nav.themes}
      </a>
      <a href={guidesHref} class="px-3 py-1.5 rounded-lg hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        {ui.nav.guides}
      </a>
    </nav>

    <!-- Header Actions (Language Switcher & Dark Mode) -->
    <div class="flex items-center gap-2">
      <!-- Accessible Native Language Switcher Dropdown (Pure HTML <details> for 0 JS support) -->
      <details class="relative language-dropdown group">
        <summary class="list-none flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-700 focus:outline-hidden focus:ring-2 focus:ring-indigo-500">
          <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>{PUBLISHED_LANGUAGES[lang]?.name || 'Language'}</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-48 bg-white dark:bg-slate-900 rounded-xl shadow-xl border border-slate-200 dark:border-slate-800 py-1.5 z-50 animate-in fade-in zoom-in-95 duration-100">
          {languageLinks.map((item) => (
            <a
              href={item.href}
              class={`flex items-center justify-between px-3.5 py-2 text-xs font-medium transition-colors ${
                item.isActive
                  ? 'bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 font-semibold'
                  : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'
              }`}
              hreflang={item.code}
            >
              <span>{item.name}</span>
              {item.isActive && (
                <svg class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              )}
            </a>
          ))}
        </div>
      </details>

      <!-- Dark Mode Theme Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors focus:outline-hidden focus:ring-2 focus:ring-indigo-500"
        aria-label="Toggle Dark Mode"
        title="Toggle Theme"
      >
        <svg id="sun-icon" class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="moon-icon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Close details dropdown when clicking outside
  document.addEventListener('click', (e) => {
    const dropdowns = document.querySelectorAll('details.language-dropdown');
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) {
        dd.removeAttribute('open');
      }
    });
  });

  // Dark Mode Toggle Logic
  const themeToggle = document.getElementById('theme-toggle-btn');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark') || document.documentElement.getAttribute('data-theme') === 'dark';
    if (isDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('ws_theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      document.documentElement.setAttribute('data-theme', 'dark');
      localStorage.setItem('ws_theme', 'dark');
    }
  });
</script>
