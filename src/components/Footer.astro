---
import type { LanguageCode } from '../i18n/config';
import { getUI } from '../i18n/ui';
import { getRelativePath } from '../i18n/slugs';

export interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const ui = getUI(lang);

// Localized links helper
const link = (id: string) => getRelativePath(id, lang);

const topColors = [
  { id: 'white-screen', name: 'White' },
  { id: 'black-screen', name: 'Black' },
  { id: 'blue-screen', name: 'Blue' },
  { id: 'green-screen', name: 'Green' },
  { id: 'red-screen', name: 'Red' },
  { id: 'yellow-screen', name: 'Yellow' },
  { id: 'orange-screen', name: 'Orange' },
  { id: 'pink-screen', name: 'Pink' },
  { id: 'purple-screen', name: 'Purple' },
  { id: 'gold-screen', name: 'Gold' },
  { id: 'grey-screen', name: 'Grey' },
  { id: 'cyan-screen', name: 'Cyan' },
];

const topTools = [
  { id: 'dead-pixel-test', name: 'Dead Pixel Test' },
  { id: 'screen-cleaning', name: 'Screen Cleaning Mode' },
  { id: 'zoom-ring-light', name: 'Zoom Ring Light' },
  { id: 'webcam-light', name: 'Webcam Fill Light' },
  { id: 'backlight-bleed-test', name: 'Backlight Bleed Test' },
  { id: 'oled-burn-in-test', name: 'OLED Burn-in Test' },
  { id: 'screen-flicker-test', name: 'Screen Flicker Test' },
  { id: 'monitor-uniformity-test', name: 'Uniformity Test' },
  { id: 'tracing-lightbox', name: 'Tracing Lightbox' },
  { id: 'fullscreen-rgb-cycle', name: 'RGB Auto Cycle' },
];

const topWallpapersAndThemes = [
  { id: 'white-wallpaper', name: 'White Wallpaper' },
  { id: 'white-wallpaper-4k', name: '4K White Wallpaper' },
  { id: 'black-wallpaper', name: 'Black Wallpaper' },
  { id: 'sky-background', name: 'Sky Background' },
  { id: 'gradient-background', name: 'Gradient Background' },
  { id: 'space-background', name: 'Space Background' },
  { id: 'forest-background', name: 'Forest Background' },
  { id: 'ocean-background', name: 'Ocean Background' },
];

const topGuides = [
  { id: 'how-to-clean-laptop-screen-safely', name: 'How to Clean Laptop Screen' },
  { id: 'how-to-check-dead-pixels-iphone-monitor', name: 'Check Dead Pixels on Monitor' },
  { id: 'can-white-screen-work-as-ring-light', name: 'White Screen as Ring Light' },
  { id: 'oled-burn-in-causes-fixes-test', name: 'OLED Burn-in Causes & Fixes' },
  { id: 'backlight-bleed-vs-ips-glow', name: 'Backlight Bleed vs IPS Glow' },
  { id: 'turn-laptop-tablet-into-tracing-lightbox', name: 'Turn Tablet into Lightbox' },
];

const legalPages = [
  { id: 'about', label: ui.footer.about },
  { id: 'contact', label: ui.footer.contact },
  { id: 'privacy-policy', label: ui.footer.privacy },
  { id: 'terms-and-conditions', label: ui.footer.terms },
  { id: 'cookie-policy', label: ui.footer.cookies },
  { id: 'license', label: ui.footer.license },
];

const homePath = lang === 'en' ? '/' : `/${lang}/`;
---

<footer class="bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 transition-colors mt-20 pt-16 pb-12 text-slate-600 dark:text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-10">
      <!-- Col 1: Brand & Slogan -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1">
        <a href={homePath} class="flex items-center gap-2.5 text-slate-900 dark:text-white font-bold text-lg tracking-tight">
          <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="3" width="18" height="18" rx="3"></rect>
            </svg>
          </div>
          <span>TheWhiteScreen<span class="text-indigo-600 dark:text-indigo-400">.org</span></span>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          {ui.footer.description}
        </p>
        <div class="mt-4 flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
          <a href="/sitemap-index.xml" class="hover:text-indigo-600 dark:hover:text-indigo-400 underline decoration-slate-300">
            XML Sitemap
          </a>
          <span>•</span>
          <a href="/robots.txt" class="hover:text-indigo-600 dark:hover:text-indigo-400 underline decoration-slate-300">
            Robots.txt
          </a>
        </div>
      </div>

      <!-- Col 2: Colors -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {ui.footer.colorsColumn}
        </h3>
        <ul class="space-y-2 text-xs">
          {topColors.map((c) => (
            <li>
              <a href={link(c.id)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Tools -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {ui.footer.toolsColumn}
        </h3>
        <ul class="space-y-2 text-xs">
          {topTools.map((t) => (
            <li>
              <a href={link(t.id)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {t.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Resources & Wallpapers -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {ui.footer.resourcesColumn}
        </h3>
        <ul class="space-y-2 text-xs">
          {topWallpapersAndThemes.map((w) => (
            <li>
              <a href={link(w.id)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {w.name}
              </a>
            </li>
          ))}
          {topGuides.slice(0, 4).map((g) => (
            <li>
              <a href={link(g.id)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {g.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Legal & Trust -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {ui.footer.legalColumn}
        </h3>
        <ul class="space-y-2 text-xs">
          {legalPages.map((l) => (
            <li>
              <a href={link(l.id)} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 dark:text-slate-500">
      <p>© {new Date().getFullYear()} TheWhiteScreen.org. {ui.footer.allRightsReserved}</p>
      <div class="flex items-center gap-4">
        <span>Static SSG • Zero Tracking • 100% Pre-rendered</span>
      </div>
    </div>
  </div>
</footer>
