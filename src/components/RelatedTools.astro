---
import type { LanguageCode } from '../i18n/config';
import { getRelativePath } from '../i18n/slugs';
import { getUI } from '../i18n/ui';

export interface RelatedItem {
  id: string;
  title: string;
  desc?: string;
  tag?: string;
}

export interface Props {
  lang: LanguageCode;
  title?: string;
  items: RelatedItem[];
}

const { lang, title, items = [] } = Astro.props;
const ui = getUI(lang);
const blockTitle = title || ui.sections.relatedToolsTitle;
---

<section class="my-12">
  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-6">
    {blockTitle}
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {items.map((item) => {
      let href = '#';
      try {
        href = getRelativePath(item.id, lang);
      } catch {
        href = `/${item.id}/`;
      }
      return (
        <a
          href={href}
          class="group block p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xs hover:shadow-md hover:border-indigo-500/50 transition-all focus:outline-hidden focus:ring-2 focus:ring-indigo-500"
        >
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-semibold text-slate-900 dark:text-white text-base group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {item.title}
            </h3>
            {item.tag && (
              <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                {item.tag}
              </span>
            )}
          </div>
          {item.desc && (
            <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2">
              {item.desc}
            </p>
          )}
          <div class="mt-3 flex items-center gap-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400">
            <span>Explore</span>
            <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      );
    })}
  </div>
</section>
